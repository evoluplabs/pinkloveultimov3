# ============================================================
# Pink Love Catálogo — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores
# do seu projeto Firebase antes de iniciar em modo Firebase.
# ============================================================

# Adapter de dados: "mock" (desenvolvimento sem Firebase)
#                   "firebase" (produção ou testes com Firestore)
VITE_DATA_SOURCE=mock

# Slug do catálogo — usado APENAS em desenvolvimento local.
# Em produção o slug é detectado automaticamente pelo subdomínio
# (ex: "loja" em "loja.pinklove.app").
VITE_CATALOG_SLUG=seuslug

# ─── Credenciais do Firebase Web App ─────────────────────────
# Encontre em: Console Firebase → Configurações do projeto →
# Seus apps → Web app → firebaseConfig

VITE_FB_API_KEY=PREENCHER
VITE_FB_AUTH_DOMAIN=PREENCHER.firebaseapp.com
VITE_FB_PROJECT_ID=PREENCHER
VITE_FB_STORAGE_BUCKET=PREENCHER.appspot.com
VITE_FB_SENDER_ID=PREENCHER
VITE_FB_APP_ID=PREENCHER
